<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitTracker.Mobile.MainPage"
             Title="Mani ieradumi"
             BackgroundColor="#F8FAFC">

    <!-- Grid dabuju no gemini, man sakuma bija verticalstacklayout, bet nevareja paiet uz leju, mi ieteica izmantot grid -->
    <Grid Padding="16" RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" Margin="0,0,0,10">
            <Label Text="Aktīvie ieradumi"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#0F172A"
                   VerticalOptions="Center" />

            <Button Grid.Column="1"
                    x:Name="RefreshButton"
                    Text="↻ Atjaunot"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="White"
                    TextColor="#334155"
                    BorderColor="#CBD5E1"
                    BorderWidth="1"
                    CornerRadius="10"
                    Padding="12,8"
                    VerticalOptions="Center" />

            <Button Grid.Column="2"
                    Text="+ Jauns"
                    Clicked="OnAddNewClicked"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    Padding="14,8"
                    VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="1"
                BackgroundColor="#16A34A"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 8"
                Padding="12,8"
                Margin="0,0,0,12"
                HorizontalOptions="Start">
            <Label x:Name="TodayProgressLabel"
                   Text="Šodien izpildīti: 0 no 0"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="White" />
        </Border>

        <RefreshView Grid.Row="2" x:Name="HabitsRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="HabitsList"
                            SelectionMode="Single"
                            SelectionChanged="OnHabitSelected">

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="30" Spacing="8">
                        <Label Text="Nav neviena aktīva ieraduma"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#334155"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Nospied '+ Jauns' augšējā stūrī, lai pievienotu pirmo!"
                               FontSize="14"
                               TextColor="#64748B"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- pievieno datus -->
                        <Border Margin="0,0,0,12"
                                Padding="16"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1.5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHabitTapped" />
                            </Border.GestureRecognizers>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BackgroundColor" Value="White" />
                                    <Setter Property="Stroke" Value="#E2E8F0" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#F0FDF4" />
                                            <Setter Property="Stroke" Value="#22C55E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"
                                           LineBreakMode="TailTruncation" />

                                    <Border Grid.Column="1"
                                            Padding="10,4"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BackgroundColor" Value="#FEF3C7" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Label FontSize="12" FontAttributes="Bold">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="Text" Value="Nav izpildīts" />
                                                    <Setter Property="TextColor" Value="#B45309" />
                                                    <Style.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Text" Value="Šodien izpildīts" />
                                                            <Setter Property="TextColor" Value="#15803D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Schedule, StringFormat='Grafiks: {0}'}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#2563EB" />

                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="#475569"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />

                                <Button CommandParameter="{Binding .}"
                                        Clicked="OnCompleteButtonClicked"
                                        Margin="0,8,0,0"
                                        CornerRadius="8"
                                        FontAttributes="Bold"
                                        HeightRequest="42">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <!-- nav izpildits krasa -->
                                            <Setter Property="Text" Value="✓ Izpildīt šodien" />
                                            <Setter Property="BackgroundColor" Value="#16A34A" />
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="IsEnabled" Value="True" />

                                            <Style.Triggers>
                                                <!-- ir izpildits krasa -->
                                                <DataTrigger TargetType="Button" Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Text" Value="✓ Šodien pabeigts" />
                                                    <Setter Property="BackgroundColor" Value="#E2E8F0" />
                                                    <Setter Property="TextColor" Value="#475569" />
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitTracker.Mobile.EditHabitPage"
             Title="Ieraduma detaļas">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Labot ieradumu" FontSize="24" FontAttributes="Bold" />
        <Label x:Name="DateLabel" TextColor="#6b7280" FontSize="14" />
        <Label x:Name="StatsLabel" TextColor="#6b7280" FontSize="14" Margin="0,0,0,15" />

        <Label Text="Nosaukums:" />
        <Entry x:Name="NameEntry" />

        <Label Text="Apraksts:" />
        <Entry x:Name="DescriptionEntry" />

        <Label Text="Cik bieži jāizpilda:" Margin="0,10,0,0" />
        <Picker x:Name="SchedulePicker" Title="Izvēlies biežumu:">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Katru dienu</x:String>
                    <x:String>Darbadienas (P-P)</x:String>
                    <x:String>3x nedela</x:String>
                    <x:String>1x nedela</x:String>
                    <x:String>Pec vajadzibas</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" FontAttributes="Bold" />

        <Button Text="Saglabāt izmaiņas" Clicked="OnSaveClicked" BackgroundColor="#3b82f6" TextColor="White" CornerRadius="5" />
        <Button Text="Arhivēt (Paslēpt)" Clicked="OnArchiveClicked" BackgroundColor="#ef4444" TextColor="White" CornerRadius="5" />
        <Button Text="Atcelt" Clicked="OnCancelClicked" BackgroundColor="Transparent" TextColor="#4b5563" />
    </VerticalStackLayout>
</ContentPage>
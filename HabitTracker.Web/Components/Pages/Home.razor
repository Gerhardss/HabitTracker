@page "/"
@using HabitTracker.Domain
@using HabitTracker.Web.Services
@inject WebHabitService HabitService

<PageTitle>Mani ieradumi</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Mani ieradumi</h1>
    <div>
        <button class="btn btn-outline-secondary me-2" @onclick="LoadHabitsAsync" disabled="@_isLoading">
            Atjaunot datus
        </button>
        <a href="/habits/add" class="btn btn-primary">Jauns ieradums</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @_successMessage
        <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Kļūda:</strong> @_errorMessage
    </div>
}

@if (_isLoading)
{
    <div class="d-flex align-items-center my-4">
        <div class="spinner-border text-primary me-2" role="status"></div>
        <span>Ielādē ieradumus no API</span>
    </div>
}
else if (_habits.Count == 0 && string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-info">
        Nav atrasts neviens aktīvs ieradums. Lai izveidotu spied <strong>Jauns ieradums</strong>!
    </div>
}
else if (_habits.Count > 0)
{
    <div class="mb-3">
        <span class="badge bg-success fs-6">
            Šodien izpildīti: @_habits.Count(h => h.IsCompleted) no @_habits.Count
        </span>
    </div>

    <div class="row g-3">
        @foreach (var habit in _habits)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 @(habit.IsCompleted ? "border-success" : "")">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@habit.Name</h5>
                            @if (habit.IsCompleted)
                            {
                                <span class="badge bg-success">Šodien izpildīts</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Nav izpildīts</span>
                            }
                        </div>

                        <h6 class="card-subtitle mb-2 text-muted">@habit.Schedule</h6>

                        @if (!string.IsNullOrWhiteSpace(habit.Description))
                        {
                            <p class="card-text">@habit.Description</p>
                        }

                        <div class="mt-auto pt-3 d-flex flex-wrap gap-2">
                            <button class="btn btn-sm @(habit.IsCompleted ? "btn-outline-success" : "btn-success")"
                                    disabled="@habit.IsCompleted"
                                    @onclick="() => CompleteHabitAsync(habit)">
                                @(habit.IsCompleted ? "Izpildīts" : "Izpildīt šodien")
                            </button>

                            <a href="/habits/@habit.ID" class="btn btn-sm btn-outline-primary">Detaļas</a>
                            <a href="/habits/edit/@habit.ID" class="btn btn-sm btn-outline-secondary">Labot</a>

                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => ArchiveHabitAsync(habit)">
                                Arhivēt
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Habit> _habits = new();
    private bool _isLoading = true;
    private string? _errorMessage;  // pazinojumi 
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadHabitsAsync();
    }

    private async Task LoadHabitsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var allHabits = await HabitService.GetAllHabitsAsync();
            _habits = allHabits.Where(h => !h.IsArchived).ToList();
        }
        catch (Exception)
        {
            _errorMessage = "API nav sasniedzams. Pārliecinies, ka API ir palaists.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CompleteHabitAsync(Habit habit)
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await HabitService.CompleteHabitAsync(habit.ID);
            _successMessage = $"Ieradums \"{habit.Name}\" veiksmīgi atzīmēts kā izpildīts šodien!";
            await LoadHabitsAsync();
        }
        catch (Exception)
        {
            _errorMessage = "Neizdevās atzīmēt ieradumu kā izpildītu. Pārbaudi savienojumu ar API.";
        }
    }

    private async Task ArchiveHabitAsync(Habit habit)
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await HabitService.ArchiveHabitAsync(habit.ID);
            _successMessage = $"Ieradums \"{habit.Name}\" tika arhivēts.";
            await LoadHabitsAsync();
        }
        catch (Exception)
        {
            _errorMessage = "Neizdevās arhivēt ieradumu. Pārbaudi savienojumu ar API.";
        }
    }
}